+#include "external_fileTree_manager.h"
+#include <new>
+#include <stdlib.h>
+#include <ion/include/ion/storage/file_system.h>
+
+namespace InternalStorage {
+
+FileTree* ExternalFileTreeManager::file_tree = nullptr;
+
+void ExternalFileTreeManager::freeFileTree() {
+    while (file_tree != nullptr) {
+        FileTree *next = file_tree->getNextTree();
+        file_tree->~FileTree();
+        free(file_tree);
+        file_tree = next;
+    }
+}
+
+FileTree *ExternalFileTreeManager::rebuildFileTree() {
+    freeFileTree();
+
+    FileTree *rootTree = nullptr;
+    FileTree *currentTree = nullptr;
+
+    Ion::Storage::FileSystem *fileSystem = Ion::Storage::FileSystem::sharedFileSystem;
+    
+    for (char *p : *fileSystem) {
+        const char *fullName = p + sizeof(Ion::Storage::FileSystem::record_size_t);
+        
+        Ion::Storage::Record::Name name = Ion::Storage::Record::CreateRecordNameFromFullName(fullName);
+
+        if (Ion::Storage::Record::NameIsEmpty(name)) {
+            continue;
+        }
+
+        void* rawMemory = malloc(sizeof(FileTree));
+        if (rawMemory == nullptr) {
+            break; 
+        }
+        
+        FileTree *newTree = new (rawMemory) FileTree(name.baseName, name.extension);
+
+        if (rootTree == nullptr) {
+            rootTree = newTree;
+            currentTree = rootTree;
+        } else {
+            currentTree->setNextTree(newTree);
+            currentTree = newTree;
+        }
+    }
+    
+    file_tree = rootTree;
+
+    return file_tree;
+}
+
+}
