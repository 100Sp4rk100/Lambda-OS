+#include <escher/include/escher/image.h>
+#include <escher/include/escher/table_view_data_source.h>
+#include <escher/include/escher/selectable_table_view.h>
+
+#include "../view/file_cell.h"
+
+namespace Explorer {
+
+class ControllerTemplate : public Escher::ViewController, public Escher::SimpleTableViewDataSource, public Escher::SelectableTableViewDelegate {
+    public:
+        ControllerTemplate(Escher::StackViewController* parentResponder, Escher::SelectableTableViewDataSource *selectionDataSource, InternalStorage::FileTree * tree);
+
+        Escher::View* view() override { return &m_view; }
+        bool handleEvent(Ion::Events::Event event) override;
+
+        Escher::HighlightCell* reusableCell(int index) override{
+            return &fileCells[index];
+        }
+        int reusableCellCount() const override {
+            return numberCells;
+        }
+        int numberOfColumns() const override {
+            return numberCellsForRows;
+        }
+        int numberOfRows() const override{
+            return numberRows;
+        }
+
+    protected:
+        virtual void selectCell(InternalStorage::FileTree * cell){}
+
+        int selected = 0;
+
+        virtual void drawFileViewRect(KDContext* ctx, KDRect rect) const {
+            ctx->fillRect(rect, Theme::ThemeGestion::getColor("KDColorWhite"));
+        }
+
+        class FileView : public Escher::View {
+            public:
+                FileView(ControllerTemplate* controller, Escher::SelectableTableViewDataSource* selectionDataSource);
+
+                void drawRect(KDContext* ctx, KDRect rect) const override {
+                    m_controller->drawFileViewRect(ctx, rect);
+                }
+
+                void reload(){ markWholeFrameAsDirty(); }
+                Escher::SelectableTableView* selectableTableView(){ return &m_selectableTableView; }
+
+            private:
+                int numberOfSubviews() const override{ return 1; }
+                View* subviewAtIndex(int index) override{ return &m_selectableTableView; }
+                void layoutSubviews(bool force = false) override;
+
+                Escher::SelectableTableView m_selectableTableView;
+
+                ControllerTemplate* m_controller;
+        };
+
+        void updateTree(InternalStorage::FileTree * tree);
+        virtual void reloadCells();
+
+    private:
+
+        void refreshCellsData();
+        const Escher::Image * getImage(const char * extension);
+        int totalFilesCount() const;
+
+        KDCoordinate defaultColumnWidth() override{ return cellWidth; }
+        KDCoordinate defaultRowHeight() override{ return cellHeight; }
+
+        constexpr static int numberCells = 6;
+        constexpr static int numberCellsForRows = 3;
+        constexpr static int numberRows = 2;
+        constexpr static int cellHeight = 104;
+        constexpr static int cellWidth = 104;
+        constexpr static int WidthMargin = 4;
+
+        FileView m_view;
+        FileCell fileCells[numberCells];
+        InternalStorage::FileTree *file_tree;
+
+        Escher::SelectableTableViewDataSource *m_selectionDataSource;
+        int level = 0;
+};
+
+}
+
+#endif
