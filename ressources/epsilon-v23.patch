diff --git a/apps/explorer/view/file_cell.cpp b/apps/explorer/view/file_cell.cpp
new file mode 100644
index 0000000000..528a14c58b
--- /dev/null
+++ b/apps/explorer/view/file_cell.cpp
@@ -0,0 +1,56 @@
+#include "file_cell.h"
+
+#include <apps/theme_gestion/themeGestion.h>
+
+namespace Explorer {
+
+FileCell::FileCell(const char * name, const Escher::Image * image){
+    text = Escher::PointerTextView(name, {
+    .style = {.font = KDFont::Size::Small}, 
+    .horizontalAlignment = KDGlyph::k_alignCenter
+    });
+
+    image_view.setImage(image);
+    hillight = false;
+}
+
+void FileCell::drawRect(KDContext *ctx, KDRect rect) const {
+    KDSize nameSize = text.minimalSizeForOptimalDisplay();
+    ctx->fillRect(KDRect(0, 0, 140, 140), Theme::ThemeGestion::getColor("KDColorWhite"));
+}
+
+Escher::View * FileCell::subviewAtIndex(int index){
+    Escher::View *views[] = {&image_view, &text};
+    return views[index];
+}
+
+int FileCell::numberOfSubviews() const {
+    return isVisible() ? 2 : 0;
+}
+
+void FileCell::layoutSubviews(bool force) {
+    setChildFrame(&image_view, KDRect((bounds().width() - 55) / 2, 10, 55, 56), force);
+
+    KDSize nameSize = text.minimalSizeForOptimalDisplay();
+    setChildFrame(&text, KDRect((bounds().width() - nameSize.width()) / 2 - 4, 65, nameSize.width() + 2 * 4, 30), force);
+}
+
+void FileCell::updateData(const char * name, const Escher::Image * image){
+    text.setText(name);
+    image_view.setImage(image);
+    layoutSubviews(true);
+}
+
+void FileCell::reload(const Escher::Image * image){
+    if(hillight){
+        text.setTextColor(Theme::ThemeGestion::getColor("KDColorWhite"));
+        text.setBackgroundColor(Theme::ThemeGestion::getColor("YellowDark"));
+    }else{
+        text.setTextColor(Theme::ThemeGestion::getColor("KDColorBlack"));
+        text.setBackgroundColor(Theme::ThemeGestion::getColor("KDColorWhite"));
+    }
+    image_view.setImage(image);
+    markWholeFrameAsDirty();
+}
+
+}
\ No newline at end of file
