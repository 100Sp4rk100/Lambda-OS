+Escher::HighlightCell* MainController::cell(int row) {
+    if (row == k_indexOfExternal) return &m_cellExternal;
+    else if (row == k_indexOfInternal) return &m_cellInternal;
+    else if (row == k_indexOfClearExternal) return &m_cellClearExternal;
+    return &m_cellClearInternal;
+}
+
+bool MainController::handleEvent(Ion::Events::Event event) {
+    if (event == Ion::Events::OK || event == Ion::Events::EXE || event == Ion::Events::Right) {
+        if (selectedRow() == k_indexOfExternal){
+            stackOpenPage(m_externalController);
+            return true;
+        }else if (selectedRow() == k_indexOfInternal){
+            stackOpenPage(m_internalController);
+            return true;
+    }
+    if (event == Ion::Events::OK || event == Ion::Events::EXE) {
+        if (selectedRow() == k_indexOfClearExternal){
+            warning_external.presentModally();
+            return true;
+        }else if (selectedRow() == k_indexOfClearInternal){
+            warning_internal.presentModally();
+            return true;
+        }
+    }
+    }
+  return false;
+}
+
+void MainController::reloadStyle(){
+    m_cellExternal.label()->setTextColor(Theme::ThemeGestion::getColor("KDColorBlack"));
+    m_cellInternal.label()->setTextColor(Theme::ThemeGestion::getColor("KDColorBlack"));
+    m_cellClearExternal.label()->setTextColor(Theme::ThemeGestion::getColor("KDColorBlack"));
+    m_cellClearInternal.label()->setTextColor(Theme::ThemeGestion::getColor("KDColorBlack"));
+
+    selectableListView()->setBackgroundColor(Theme::ThemeGestion::getColor("KDColorWhite"));
+}
+
+}
