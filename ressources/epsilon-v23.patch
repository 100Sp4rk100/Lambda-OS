+
+namespace InternalStorage {
+
+AdressTree* InternalManager::adressTree = nullptr;
+FileTree* InternalManager::fileTree = nullptr;
+size_t InternalManager::fileSpace = 0;
+size_t InternalManager::dirtySpace = 0;
+
+#if !PLATFORM_DEVICE
+uint8_t InternalManager::s_simulatorFlash[InternalManager::k_simulatorFlashSize] = {0};
+#endif
+
+void InternalManager::initInternalStorage() {
+    if (adressTree == nullptr) {
+        void* rawMemory = malloc(sizeof(AdressTree));
+        adressTree = new (rawMemory) AdressTree();
+    }
+
+    #if !PLATFORM_DEVICE
+    static bool simulatedFlashInitialized = false;
+    if (!simulatedFlashInitialized) {
+        memset(s_simulatorFlash, 0xFF, k_simulatorFlashSize);
+        simulatedFlashInitialized = true;
+    }
+
+    #endif
+
+    notifyUpdate();
+}
+
+Error InternalManager::notifyUpdate(){
+    /*
+    A record in storage have this layout :
+    | Magic (uint32) | Buffer size (uint32) | Full name (16o) | Flag (1o) | Padding flag (3o) | Buffer (dynamic) | Padding buffer (0 to 3o) |
+
+    If the flag is 0xFF : the file exist.
+    If the flag is 0x00 : the file doesn't exist
+
+    The padding flag and the padding buffer are to align record on a multiple of 4.
+    */
+
+    fileSpace = 0;
+    dirtySpace = 0;
+
+    // destroy the old AdressTree
+    AdressTree * clear_addr_ptr = adressTree;
+    while (clear_addr_ptr != nullptr) {
+        AdressTree * next = clear_addr_ptr->getNextTree();
+        clear_addr_ptr->~AdressTree(); 
+        free(clear_addr_ptr);
+        clear_addr_ptr = next;
+    }
+
+    // destroy the old FileTree
+    FileTree * clear_file_ptr = fileTree;
+    while (clear_file_ptr != nullptr) {
+        FileTree * next = clear_file_ptr->getNextTree();
+        clear_file_ptr->~FileTree(); 
+        free(clear_file_ptr);
+        clear_file_ptr = next;
+    }
+
+    fileTree = nullptr;
+    adressTree = nullptr;
+
+    FileTree *p_fileTree = fileTree;
+    AdressTree *p_adressTree = adressTree;
+
+    uint8_t * adress = managerStartAdress();
+
+    while (adress + sizeof(uint32_t) * 2 + maxNameLength + 1 < managerEndAdress()){
+        uint32_t magic = *reinterpret_cast<uint32_t*>(adress);
+        uint32_t current_buffer_size = *reinterpret_cast<uint32_t*>(adress + sizeof(uint32_t));
+        uint8_t flag = *reinterpret_cast<uint8_t*>(adress + sizeof(uint32_t) * 2 + maxNameLength);
+        
+        if (magic != Magic) {
+            break;
+        }
+
+        if (flag != 0xFF) {
+            // File doesn't exist so we pass to the next
+            adress += (sizeof(uint32_t) * 2) + maxNameLength + 4 + current_buffer_size + getPadingForBufferSize(current_buffer_size);
+            dirtySpace += (sizeof(uint32_t) * 2) + maxNameLength + 4 + current_buffer_size + getPadingForBufferSize(current_buffer_size);
+            continue;
+        }
+
+        if (adress + (sizeof(uint32_t) * 2) + maxNameLength + 4 + current_buffer_size 
+            + getPadingForBufferSize(current_buffer_size) > managerEndAdress()) {
+            break;
+        }
+
+        //Create Trees
+        const char * fullName = reinterpret_cast<const char *>(adress + (sizeof(uint32_t) * 2));
+
+        size_t name_size = strlen(fullName);
+        size_t i = 0;
+        while (i < name_size && fullName[i] != '.'){
+            i++;
+        }
+        
+        const char * extentionPointer = fullName + i + 1;
+
+        if (fileTree == nullptr){
+            void* rawMemory = malloc(sizeof(FileTree));
+            if (rawMemory == nullptr) {
+                break; 
+            }
+            fileTree = new (rawMemory) FileTree(fullName, extentionPointer);
+            p_fileTree = fileTree;
+        }else {
+            void* rawMemory = malloc(sizeof(FileTree));
+            if (rawMemory == nullptr) {
+                break; 
+            }
+            FileTree *node = new (rawMemory) FileTree(fullName, extentionPointer);
+            p_fileTree->setNextTree(node);
+            p_fileTree = node;
+        }
+
+        if (adressTree == nullptr){
+            void* rawMemory = malloc(sizeof(AdressTree));
+            if (rawMemory == nullptr) {
+                break; 
+            }
+            adressTree = new (rawMemory) AdressTree(adress);
+            p_adressTree = adressTree;
+        }else {
+            void* rawMemory = malloc(sizeof(AdressTree));
+            if (rawMemory == nullptr) {
+                break; 
+            }
+            AdressTree *node = new (rawMemory) AdressTree(adress);
+            p_adressTree->setNextTree(node);
+            p_adressTree = node;
+        }
+
+        // go to the next address
+        adress += (sizeof(uint32_t) * 2) + maxNameLength + 4 + current_buffer_size + getPadingForBufferSize(current_buffer_size);
+        fileSpace += (sizeof(uint32_t) * 2) + maxNameLength + 4 + current_buffer_size + getPadingForBufferSize(current_buffer_size);
+    }
+
+    return Success;
+}
+
+Error InternalManager::fullErase(){
+    if (adressTree == nullptr){
+        return AdressTreeEmpty;
+    }
+
+    uint32_t invalid_file = 0x00;
+
+    #if PLATFORM_DEVICE
+    const uint8_t * src_buffer = reinterpret_cast<const uint8_t *>(&invalid_file);
+    #endif
+
+    AdressTree * p_tree = adressTree;
+
+    while (p_tree != nullptr && p_tree->getAdress() != nullptr){
+        uint8_t * adress = p_tree->getAdress() + sizeof(uint32_t) * 2 + maxNameLength;
+
+        #if PLATFORM_DEVICE
+        Ion::Device::Flash::WriteMemoryWithInterruptions(
+            adress, 
+            src_buffer,
+            sizeof(uint32_t),
+            true
+        );
+        #else
+        *reinterpret_cast<uint32_t*>(adress) = invalid_file;
+        #endif
+
+        p_tree = p_tree->getNextTree();
+    }
+
+    notifyUpdate();
+    return Success;
+}
+
+Error InternalManager::saveFile(InternalFile file){
+    size_t total_file_structure_size = (sizeof(uint32_t) * 2) + maxNameLength + 4 + file.record.size + getPadingForBufferSize(file.record.size);
+
+    if (totalSize() - fileSpace - dirtySpace < total_file_structure_size){
+        return SpaceError;
+    }
+
+    uint8_t * write_address = managerStartAdress();
+
+    while (write_address + sizeof(uint32_t) * 2 + maxNameLength + 1 < managerEndAdress()){
+        uint32_t magic = *reinterpret_cast<uint32_t*>(write_address);
+        if (magic != Magic) {
+            break;
+        }
+        uint32_t current_buffer_size = *reinterpret_cast<uint32_t*>(write_address + sizeof(uint32_t));
+
+        if (current_buffer_size > totalSize()) {
+            break; 
+        }
+
+        write_address += (sizeof(uint32_t) * 2) + maxNameLength + 4 + current_buffer_size + getPadingForBufferSize(current_buffer_size);
+    }
+
+    if (write_address == nullptr || write_address + total_file_structure_size > managerEndAdress()) {
+        return AdressError;
+    }
+
+    constexpr size_t headerSize = (sizeof(uint32_t) * 2) + maxNameLength + 4;
+    uint8_t localHeader[headerSize];
+    memset(localHeader, 0, headerSize);
+
+    *reinterpret_cast<uint32_t*>(localHeader) = Magic;
+
+    *reinterpret_cast<uint32_t*>(localHeader + sizeof(uint32_t)) = file.record.size;
+
+    const char* fileName = file.getName();
+    size_t i = 0;
+    while (i < maxNameLength - 1 && fileName[i] != '\0') {
+        localHeader[sizeof(uint32_t) * 2 + i] = fileName[i];
+        i++;
+    }
+
+    uint32_t flag_and_padding = 0x000000FF;
+    *reinterpret_cast<uint32_t*>(localHeader + sizeof(uint32_t) * 2 + maxNameLength) = flag_and_padding;
+
+    #if PLATFORM_DEVICE
+    Ion::Device::Flash::WriteMemoryWithInterruptions(
+        write_address, 
+        localHeader,
+        headerSize,
+        true
+    );
+    #else
+    memcpy(write_address, localHeader, headerSize);
+    #endif
+
+    write_address += headerSize;
+
+    if (file.record.size > 0 && file.record.buffer != nullptr) {
+        #if PLATFORM_DEVICE
+        Ion::Device::Flash::WriteMemoryWithInterruptions(
+            write_address, 
+            reinterpret_cast<const uint8_t *>(file.record.buffer), 
+            file.record.size, 
+            true
+        );
+        #else
+        memcpy(write_address, file.record.buffer, file.record.size);
+        #endif
+    }
+
+    notifyUpdate();
+    return Success;
+}
+
+Error InternalManager::eraseFile(InternalFile file){
+    if (adressTree == nullptr) {
+        return AdressTreeEmpty;
+    }
+
+    uint32_t file_flag = 0x00000000;
+    uint8_t * write_address = const_cast<uint8_t*>(reinterpret_cast<const uint8_t*>(file.record.buffer)) - 4;
+
+    #if PLATFORM_DEVICE
+    const uint8_t * src_buffer = reinterpret_cast<const uint8_t *>(&file_flag);
+    #endif
+
+    #if PLATFORM_DEVICE
+    Ion::Device::Flash::WriteMemoryWithInterruptions(
+        write_address,
+        src_buffer,
+        sizeof(uint32_t),
+        true
+    );
+    #else
+    *reinterpret_cast<uint8_t*>(write_address) = file_flag;
+    #endif
+
+    notifyUpdate();
+    return Success;
+}
+
+InternalFile InternalManager::getFile(const char * name){
+    if (adressTree == nullptr){
+        return InternalFile();
+    }
+
+    AdressTree * p_tree = adressTree;
+
+    while (p_tree != nullptr){
+        uint8_t * adress = p_tree->getAdress();
+
+        const char * fullName = reinterpret_cast<const char *>(adress + (sizeof(uint32_t) * 2));
+
+        if (strcmp(fullName, name) == 0){
+            InternalFile file = InternalFile(fullName);
+            file.record = InternalRecord(adress);;
+            
+            return file;
+        }
+
+        p_tree = p_tree->getNextTree();
+    }
+
+    return InternalFile();
+}
+
+uint32_t InternalManager::getPadingForBufferSize(uint32_t bufferSize){
+    return (4 - (bufferSize % 4)) % 4;
+}
+
+}
