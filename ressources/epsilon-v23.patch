+/* py/parsenum.h is a C header which uses C keyword restrict.
+ * It does not exist in C++ so we define it here in order to be able to include
+ * py/parsenum.h header. */
+#ifdef __cplusplus
+#define restrict  // disable
+#endif
+
+extern "C" {
+#include "py/lexer.h"
+#include "py/nlr.h"
