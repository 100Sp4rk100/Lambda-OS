+void ConsoleController::viewWillAppear() {
+  ViewController::viewWillAppear();
+  loadPythonEnvironment();
+  if (m_importScriptsWhenViewAppears) {
+    m_importScriptsWhenViewAppears = false;
+    autoImport();
+  }
+
+  reloadData();
+}
