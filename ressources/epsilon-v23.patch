-Layout LayoutCursor::leftLayout() {
-  assert(!isUninitialized());
-  if (!m_layout.isHorizontal()) {
-    return m_position == 1 ? m_layout : Layout();
-  }
-  if (m_layout.numberOfChildren() == 0 || m_position == 0) {
-    return Layout();
-  }
-  return m_layout.childAtIndex(m_position - 1);
-}
