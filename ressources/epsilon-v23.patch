+#ifndef __EXPLORER_FILE_CELL_H__
+#define __EXPLORER_FILE_CELL_H__
+
+#include <escher/include/escher/highlight_cell.h>
+#include <escher/include/escher/image.h>
+#include <escher/include/escher/pointer_text_view.h>
+#include <escher/include/escher/transparent_image_view_moded.h>
+
+namespace Explorer {
+
+class FileCell : public Escher::HighlightCell {
+    public:
+        FileCell(const char * name = nullptr, const Escher::Image * image = nullptr);
+
+        int numberOfSubviews() const override;
+        Escher::View *subviewAtIndex(int index) override;
+        void layoutSubviews(bool force = false) override;
+        void drawRect(KDContext *ctx, KDRect rect) const override;
+
+        void reload(const Escher::Image * image);
+        void updateData(const char * name = nullptr, const Escher::Image * image = nullptr);
+        void setHillight(bool h){ hillight = h; };
+
+    private:
+        Escher::PointerTextView text;
+        Escher::TransparentImageViewModed image_view;
+
+        bool hillight;
+};
+
+}
+
+#endif
