+  // WithCursor
+  m_cursor = cursor;
+  m_cursorView = cursorView;
+}
+
+void CobwebGraphView::drawBackground(KDContext *ctx, KDRect rect) const {
+  if (shouldUpdate()) {
+    return;
+  }
+  ctx->fillRect(rect, backgroundColor());
+}
