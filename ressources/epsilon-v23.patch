+#ifndef __INTERNAL_RECORD_H__
+#define __INTERNAL_RECORD_H__
+
+#include <stdint.h>
+#include "common.h"
+
+namespace InternalStorage {
+
+class InternalRecord {
+    public:
+        InternalRecord(uint8_t *address = nullptr){
+            if (address != nullptr) {
+                size = *reinterpret_cast<uint32_t*>(address + sizeof(uint32_t));
+                buffer = reinterpret_cast<const void * >(address + (sizeof(uint32_t) * 2) + maxNameLength + 4);
+            } else {
+                size = 0;
+                buffer = nullptr;
+            }
+        }
+
+        const void * buffer;
+        uint32_t size;
+};
+
+}
+
+#endif
