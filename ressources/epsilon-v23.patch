+bool ExternalSubController::textFieldDidFinishEditing(Escher::AbstractTextField* textField, Ion::Events::Event event) {
+    const char * new_name = textField->draftText();
+    
+    Ion::Storage::Record file_record = Ion::Storage::FileSystem::sharedFileSystem->recordNamed(m_tree->getCurrentName());
+
+    if (file_record.isNull() || !Ion::Storage::FileSystem::sharedFileSystem->hasRecord(file_record)) {
+        return false;
+    }
+
+    Ion::Storage::Record::ErrorStatus name_status = Ion::Storage::Record::SetFullName(&file_record, new_name);
+
+    if (name_status != Ion::Storage::Record::ErrorStatus::None){
+        return false;
+    }
+
+    Ion::Storage::FileSystem::sharedFileSystem->notifyChangeToDelegate(file_record);
+
+    m_cellName.textField()->setText(new_name);
+
+    Escher::App::app()->setFirstResponder(selectableListView());
+    static_cast<Escher::StackViewController*>(parentResponder())->pop();
+    return true;
+}
