-        /* SDL only supports "copy" style drag and drop */
-        if (has_mime == SDL_TRUE) {
-            dnd_action = WL_DATA_DEVICE_MANAGER_DND_ACTION_COPY;
-        }
-        if (wl_data_offer_get_version(data_device->drag_offer->offer) >= 3) {
