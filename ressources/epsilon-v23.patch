-static SDL_INLINE SDL_bool
-IsAcceptingDragAndDrop(void)
-{
-    if ((SDL_GetEventState(SDL_DROPFILE) == SDL_ENABLE) ||
-        (SDL_GetEventState(SDL_DROPTEXT) == SDL_ENABLE)) {
-        return SDL_TRUE;
-    }
