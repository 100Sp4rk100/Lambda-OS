-            } else {
-                WAYLAND_wl_list_init(&(data_source->mimes));
-                data_source->source = id;
-                wl_data_source_set_user_data(id, data_source);
-                wl_data_source_add_listener(id, &data_source_listener,
-                                            data_source);
