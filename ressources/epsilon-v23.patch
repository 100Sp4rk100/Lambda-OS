+            KMSDRM_drmModeFreePlane((*plane)->plane);
+            (*plane)->plane = NULL;
+        }
+        if ((*plane)->props_info) {
+            SDL_free((*plane)->props_info);
+            (*plane)->props_info = NULL;
+        }
+        SDL_free(*plane);
+        *plane = NULL;
