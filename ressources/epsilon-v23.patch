+bool StoreController::deleteCellValue(int series, int i, int j,
+                                      bool authorizeNonEmptyRowDeletion) {
+  return m_store->deleteValueAtIndex(series, m_store->relativeColumn(i), j - 1,
+                                     authorizeNonEmptyRowDeletion);
+}
