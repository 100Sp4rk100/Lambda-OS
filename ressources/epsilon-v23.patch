-        } else {
-            /* SET_ALPHA */
-            Uint32 mask = ((Uint32)info->a) << dstfmt->Ashift;
-#if SDL_BYTEORDER == SDL_LIL_ENDIAN
-            int i0 = 0, i1 = 1, i2 = 2;
-#else
-            int i0 = srcbpp - 1 - 0;
-            int i1 = srcbpp - 1 - 1;
-            int i2 = srcbpp - 1 - 2;
-#endif
-            while (height--) {
-                /* *INDENT-OFF* */
-                DUFFS_LOOP(
-                {
-                    Uint32 *dst32 = (Uint32*)dst;
-                    Uint8 s0 = src[i0];
-                    Uint8 s1 = src[i1];
