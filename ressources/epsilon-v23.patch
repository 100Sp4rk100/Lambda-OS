+
+const Escher::Image * DynamicIconProfil::getIcon(const char* name) const {
+    static const uint8_t* iconAddresses[42] = {
+        #if PLATFORM_DEVICE
+        /*
+        OFFSETS:
+        - BACKGROUND: 320*240*2
+        - IMAGES : previous offsets + size_x * size_y * 2 + 2
+        - + 2 is the flag to know if the icon is present or not. 1 = present, 0 = not present
+
+        EXAMPLE:
+        - CalculationIcon : 320*240*2 = 153600
+        - CodeIcon : CalculationIcon + 55*56*2 + 2 = 153600 + 6160 + 2 = 159762
+        */
+
+        // Icons
+        &_external_apps_flash_start + 153600, // 0: CalculationIcon
+        &_external_apps_flash_start + 159762, // 1: CodeIcon
+        &_external_apps_flash_start + 165924, // 2: DistributionIcon
+        &_external_apps_flash_start + 172086, // 3: ElementIcon
+        &_external_apps_flash_start + 178248, // 4: FinanceIcon
+        &_external_apps_flash_start + 184410, // 5: GraphIcon
+        &_external_apps_flash_start + 190572, // 6: InferenceIcon
+        &_external_apps_flash_start + 196734, // 7: RegressionIcon
+        &_external_apps_flash_start + 202896, // 8: SequenceIcon
+        &_external_apps_flash_start + 209058, // 9: SettingsIcon
+        &_external_apps_flash_start + 215220, // 10: SolverIcon
+        &_external_apps_flash_start + 221382, // 11: StatIcon
+        &_external_apps_flash_start + 227544, // 12: OffIcon
+        &_external_apps_flash_start + 233706, // 13: LambdaIcon
+
+        // Images
+        &_external_apps_flash_start + 239868, // 14 : PressToTestSuccessEpsilon
+        &_external_apps_flash_start + 240208, // 15 : HistogramIcon
+        &_external_apps_flash_start + 241202, // 16 : BoxIcon
+        &_external_apps_flash_start + 241638, // 17 : CumulativeIcon
+        &_external_apps_flash_start + 242818, // 18 : StatisticsNormalIcon
+        &_external_apps_flash_start + 243874, // 19 : ConfidenceInterval
+        &_external_apps_flash_start + 246306, // 20 : SignificanceTest
+        &_external_apps_flash_start + 248738, // 21 : BinomialIcon
+        &_external_apps_flash_start + 250070, // 22 : ExponentialIcon
+        &_external_apps_flash_start + 251402, // 23 : ChiSquaredIcon
+        &_external_apps_flash_start + 252734, // 24 : GeometricIcon
+        &_external_apps_flash_start + 254066, // 25 : PoissonIcon
