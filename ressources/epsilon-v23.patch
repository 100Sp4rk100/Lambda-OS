+Uint32
+SDL_GetWindowID(SDL_Window * window)
+{
+    CHECK_WINDOW_MAGIC(window, 0);
+
+    return window->id;
+}
+
+SDL_Window *
+SDL_GetWindowFromID(Uint32 id)
+{
+    SDL_Window *window;
+
+    if (!_this) {
+        return NULL;
+    }
+    for (window = _this->windows; window; window = window->next) {
+        if (window->id == id) {
+            return window;
+        }
+    }
+    return NULL;
+}
