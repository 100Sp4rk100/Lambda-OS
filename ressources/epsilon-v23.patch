+  virtual double getValue(uint8_t param) const {
+    assert(param < k_numberOfSharedDoubleValues);
+    return m_sharedValues[param];
+  }
+
+  void setUnknown(uint8_t param) {
+    assert(m_unknown < numberOfUnknowns());
