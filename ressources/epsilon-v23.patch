+void AbstractPlotView::drawLayout(KDContext *ctx, KDRect rect, Layout layout,
+                                  Coordinate2D<float> xy,
+                                  RelativePosition xPosition,
+                                  RelativePosition yPosition, KDColor color,
+                                  bool ignoreMargin) const {
