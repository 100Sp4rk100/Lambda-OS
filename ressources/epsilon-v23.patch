-static struct wl_surface*
-touch_surface(SDL_TouchID id)
-{
-    struct SDL_WaylandTouchPoint* tp = touch_points.head;
-
-    while (tp) {
-        if (tp->id == id) {
-            return tp->surface;
-        }
-
-        tp = tp->next;
-    }
-
-    return NULL;
-}
