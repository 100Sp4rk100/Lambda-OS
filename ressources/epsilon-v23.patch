-static void
-GLES2_DestroyRenderer(SDL_Renderer *renderer)
-{
-    GLES2_RenderData *data = (GLES2_RenderData *)renderer->driverdata;
-
-    /* Deallocate everything */
-    if (data) {
-        GLES2_ActivateRenderer(renderer);
