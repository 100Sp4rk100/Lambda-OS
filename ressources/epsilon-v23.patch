+Escher::HighlightCell* ExternalSubController::cell(int row) {
+    if (row == k_indexOfDelete) return &m_cellDelete;
+    else if (row == k_indexOfMove) return &m_cellMove;
+    else if (row == k_indexOfCopie) return &m_cellCopie;
+    else if (row == k_indexOfActivate) return &m_cellActivate;
+    return &m_cellName;
+}
+
+bool ExternalSubController::handleEvent(Ion::Events::Event event) {
+  if (event == Ion::Events::OK || event == Ion::Events::EXE) {
+    if (selectedRow() == k_indexOfDelete){
+        if (strcmp(m_tree->getCurrentExtension(), "sys")==0){
+            warning_controller.setRecordName(m_tree->getCurrentName());
+            warning_controller.setStackView(static_cast<Escher::StackViewController*>(parentResponder()));
+            warning_controller.presentModally();
+        }else{
+            Ion::Storage::Record file_record = Ion::Storage::FileSystem::sharedFileSystem->recordNamed(m_tree->getCurrentName());
+            
+            if (file_record.isNull() || !Ion::Storage::FileSystem::sharedFileSystem->hasRecord(file_record)) {
+                return false;
+            }
+
+            file_record.tryToDestroy();
+            Ion::Storage::FileSystem::sharedFileSystem->notifyChangeToDelegate(file_record);
+
+            static_cast<Escher::StackViewController*>(parentResponder())->pop();
+        }
+
+        return true;
+    }else if (selectedRow() == k_indexOfMove){
+        Ion::Storage::Record file_record = Ion::Storage::FileSystem::sharedFileSystem->recordNamed(m_tree->getCurrentName());
+        
+        if (file_record.isNull() || !Ion::Storage::FileSystem::sharedFileSystem->hasRecord(file_record)) {
+            return false;
+        }
+
+        Ion::Storage::Record::Data record_data = file_record.value();
+
+        if (record_data.buffer == nullptr) {
+            return false;
+        }
+
+        InternalStorage::InternalFile file = InternalStorage::InternalFile(m_tree->getCurrentName());
+        file.record.buffer = record_data.buffer;
+        file.record.size = record_data.size;
+
+        InternalStorage::Error err = InternalStorage::InternalManager::saveFile(file);
+
+        if (err != InternalStorage::Success) {
+            return false;
+        }
+
+        file_record.tryToDestroy();
+        Ion::Storage::FileSystem::sharedFileSystem->notifyChangeToDelegate(file_record);
+
+        static_cast<Escher::StackViewController*>(parentResponder())->pop();
+        return true;
+    }else if (selectedRow() == k_indexOfCopie){
+        Ion::Storage::Record file_record = Ion::Storage::FileSystem::sharedFileSystem->recordNamed(m_tree->getCurrentName());
+        
+        if (file_record.isNull() || !Ion::Storage::FileSystem::sharedFileSystem->hasRecord(file_record)) {
+            return false;
+        }
+
+        Ion::Storage::Record::Data record_data = file_record.value();
+
+        if (record_data.buffer == nullptr) {
+            return false;
+        }
+
+        InternalStorage::InternalFile file = InternalStorage::InternalFile(m_tree->getCurrentName());
+        file.record.buffer = record_data.buffer;
+        file.record.size = record_data.size;
+
+        InternalStorage::Error err = InternalStorage::InternalManager::saveFile(file);
+
+        if (err != InternalStorage::Success) {
+            return false;
+        }
+
+        static_cast<Escher::StackViewController*>(parentResponder())->pop();
+        return true;
+    }else if (selectedRow() == k_indexOfActivate){
+        if (!(strcmp(m_tree->getCurrentExtension(), "theme") == 0 || strcmp(m_tree->getCurrentExtension(), "anim") == 0)){
+            return false;
+        }
+
+        Ion::Storage::Record file_record = Ion::Storage::FileSystem::sharedFileSystem->recordNamed(m_tree->getCurrentName());
+        
+        if (file_record.isNull() || !Ion::Storage::FileSystem::sharedFileSystem->hasRecord(file_record)) {
+            return false;
+        }
+
+        Ion::Storage::Record::Data record_data = file_record.value();
+
+        if (record_data.buffer == nullptr) {
+            return false;
+        }
+
+        if (strcmp(m_tree->getCurrentExtension(), "theme") == 0){
+            Theme::DynamicColorProfilGestion::loadBuffer(static_cast<const uint16_t *>(record_data.buffer));
+            Theme::ThemeGestion::setCurrent(4);
+            AppsContainer::sharedAppsContainer()->reloadTitleBarView();
+        }else {
+            AnimationGestion::Controller::waitToLoad(record_data.buffer);
+            if (!AnimationGestion::Controller::is_running){
+                AnimationGestion::Controller::activate();
+            }
+        }
+        static_cast<Escher::StackViewController*>(parentResponder())->pop();
+    }
+  }
+  
+  return false;
+}
