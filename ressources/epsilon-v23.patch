-
-    if (flags == (window->flags & FULLSCREEN_MASK)) {
-        return 0;
-    }
-
-    /* clear the previous flags and OR in the new ones */
-    oldflags = window->flags & FULLSCREEN_MASK;
-    window->flags &= ~FULLSCREEN_MASK;
-    window->flags |= flags;
