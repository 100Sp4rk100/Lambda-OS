+bool InternalSubController::textFieldDidFinishEditing(Escher::AbstractTextField* textField, Ion::Events::Event event) {
+    const char * new_name = textField->draftText();
+
+    if (strcmp(new_name, m_tree->getCurrentName()) == 0){
+        return true;
+    }
+
+    InternalStorage::InternalFile old_file = InternalStorage::InternalManager::getFile(m_tree->getCurrentName());
+    if (!old_file.isValable()) {
+        return true;
+    }
+
+    size_t data_size = old_file.record.size;
+    void * temp_buffer = nullptr;
+    
+    if (data_size > 0 && old_file.record.buffer != nullptr) {
+        temp_buffer = malloc(data_size);
+        if (temp_buffer == nullptr) {
+            return false;
+        }
+        memcpy(temp_buffer, old_file.record.buffer, data_size);
+    }
+
+    InternalStorage::InternalFile new_file(new_name);
+    new_file.record.buffer = temp_buffer;
+    new_file.record.size = data_size;
+
+    InternalStorage::Error err = InternalStorage::InternalManager::saveFile(new_file);
+
+    if (temp_buffer != nullptr) {
+        free(temp_buffer);
+    }
+
+    if (err == InternalStorage::Success) {
+        InternalStorage::InternalManager::eraseFile(old_file);
+    } else {
+        return false;
+    }
+
+    m_cellName.textField()->setText(new_name);
+
+    Escher::App::app()->setFirstResponder(selectableListView());
+    static_cast<Escher::StackViewController*>(parentResponder())->pop();
+    return true;
+}
