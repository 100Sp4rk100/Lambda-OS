diff --git a/apps/animation/animation.cpp b/apps/animation/animation.cpp
new file mode 100644
index 0000000000..982224a817
--- /dev/null
+++ b/apps/animation/animation.cpp
@@ -0,0 +1,359 @@
+#include "animation.h"
+
+#include <ion/display.h>
+
+#include <kandinsky/rect.h>
+
+namespace AnimationGestion{
+
+bool Controller::is_running = false;
+const void * Controller::tmp_b = nullptr;
+
+int Controller::offset = 0;
+int Controller::img_x = 0;
+int Controller::img_y = 0;
+int Controller::old_x = 0;
+int Controller::old_y = 0;
+int Controller::variables[4] = {0, 0, 0, 0};
+bool Controller::skip_next_instruction = false;
+
+const void* Controller::buffer = nullptr;
+KDColor Controller::replacement_color = KDColor::RGB24(0xFFFFFFFF);
+int Controller::tick_ms = 0;
+
+uint16_t Controller::img_buffer[1024] = {};
+uint16_t Controller::save_buffer[1024] = {};
+bool Controller::transparent_mask[1024] = {};
+
+void Controller::loadAnimation(const void * b){
+    buffer = b;
+    tmp_b = nullptr;
+
+    //load header
+    const uint16_t* src = static_cast<const uint16_t*>(b);
+
+    //fill img_buffer
+    for (int y=0; y<16; y++){
+        for (int x=0; x<16; x++){
+            uint16_t color = src[(y * 16) + x];
+
+            //we resize 16x16 img to 32x32 img
+            int target_x = x * 2;
+            int target_y = y * 2;
+
+            img_buffer[(target_y * 32) + target_x] = color;
+            img_buffer[(target_y * 32) + target_x + 1] = color;
+            img_buffer[((target_y + 1) * 32) + target_x] = color;
+            img_buffer[((target_y + 1) * 32) + target_x + 1] = color;
+        }
+    }
+
+    offset = 512;
+
+    const uint8_t* byte_buffer = static_cast<const uint8_t*>(b);
+
+    //get tick_ms
+    tick_ms = *reinterpret_cast<const uint16_t*>(byte_buffer + offset);
+    offset += sizeof(uint16_t);
+
+    //get replacement_color
+    uint16_t color_val = *reinterpret_cast<const uint16_t*>(byte_buffer + offset);
+    replacement_color = *reinterpret_cast<KDColor*>(&color_val);
+    offset += sizeof(uint16_t);
+
+    //get base position
+    img_x = *reinterpret_cast<const uint16_t*>(byte_buffer + offset);
+    offset += sizeof(uint16_t);
+    img_y = *reinterpret_cast<const uint16_t*>(byte_buffer + offset);
+    offset += sizeof(uint16_t);
+
+    old_x = img_x;
+    old_y = img_y;
+
+    for (int i=0; i<4; i++){
+        variables[i] = 0;
+    }
+
+    skip_next_instruction = false;
+
+    //save base buffer of screen
+    Ion::Display::pullRect(KDRect(img_x, img_y, 32, 32), reinterpret_cast<KDColor*>(save_buffer));
+
+    //apply transparence
+    for (int y = 0; y < 16; y++) {
+        for (int x = 0; x < 16; x++) {
+            uint16_t color = src[(y * 16) + x];
+            bool is_trans = (KDColor::RGB16(color) == replacement_color);
+
+            int target_x = x * 2;
+            int target_y = y * 2;
+
+            int idx0 = (target_y * 32) + target_x;
+            int idx1 = idx0 + 1;
+            int idx2 = ((target_y + 1) * 32) + target_x;
+            int idx3 = idx2 + 1;
+
+            transparent_mask[idx0] = is_trans;
+            transparent_mask[idx1] = is_trans;
+            transparent_mask[idx2] = is_trans;
+            transparent_mask[idx3] = is_trans;
+
+            img_buffer[idx0] = is_trans ? save_buffer[idx0] : color;
+            img_buffer[idx1] = is_trans ? save_buffer[idx1] : color;
+            img_buffer[idx2] = is_trans ? save_buffer[idx2] : color;
+            img_buffer[idx3] = is_trans ? save_buffer[idx3] : color;
+        }
+    }
+    
+    Ion::Display::pushRect(KDRect(img_x, img_y, 32, 32), reinterpret_cast<const KDColor*>(img_buffer));
+}
+
+void Controller::step(){
+    if(buffer == nullptr){
+        return;
+    }
+
+    const uint8_t* byte_buffer = static_cast<const uint8_t*>(buffer);
+
+    applyScreenChanges(byte_buffer);
+
+    //execute codes
+    uint8_t current_code = 0xFF;
+    bool pending_false_branch = false;
+
+    while (true) {
+        //get code
+        current_code = *reinterpret_cast<const uint8_t*>(byte_buffer + offset);
+        offset += sizeof(uint8_t);
+
+        // get args for code
+        uint8_t args[3];
+        int n_args = getNumberOfArgsForCode(current_code);
+
+        for (int i = 0; i<n_args; i++){
+            uint8_t arg = *reinterpret_cast<const uint8_t*>(byte_buffer + offset);
+            offset += sizeof(uint8_t);
+
+            args[i] = arg;
+        }
+
+        // dont execute the false case if the previous case was true
+        if (skip_next_instruction){
+            skip_next_instruction = false;
+            continue;
+        }
+
+        // execute the logic
+        switch (current_code){
+            case 0x01:{ // move
+                img_x += static_cast<int8_t>(args[0]);
+                img_y += static_cast<int8_t>(args[1]);
+                break;
+            }
+            case 0x03: jump(byte_buffer, args); break;
+            case 0x04: variables[0] += static_cast<int8_t>(args[0]); break; // add var 0
+            case 0x05: variables[1] += static_cast<int8_t>(args[0]); break; // add var 1
+            case 0x06: variables[2] += static_cast<int8_t>(args[0]); break; // add var 2
+            case 0x07: variables[3] += static_cast<int8_t>(args[0]); break; // add var 3
+            case 0x08: case_code(byte_buffer, args); 
+                if (!skip_next_instruction) {
+                    pending_false_branch = true;
+                }
+                break;
+            case 0x12: variables[0] = static_cast<int8_t>(args[0]); break; // set var 0
+            case 0x13: variables[1] = static_cast<int8_t>(args[0]); break; // set var 1
+            case 0x14: variables[2] = static_cast<int8_t>(args[0]); break; // set var 2
+            case 0x15: variables[3] = static_cast<int8_t>(args[0]); break; // set var 3
+            default: break;
+        }
+
+        if (current_code == 0x00 || current_code == 0x02 || current_code == 0x03) {
+            if (pending_false_branch) {
+                if (current_code != 0x03) {
+                    uint8_t false_code = *reinterpret_cast<const uint8_t*>(byte_buffer + offset);
+                    offset += sizeof(uint8_t);
+                    offset += getNumberOfArgsForCode(false_code);
+                }
+                pending_false_branch = false;
+            }
+            break;
+        }
+
+        if (pending_false_branch && current_code != 0x08) {
+            skip_next_instruction = true;
+            pending_false_branch = false;
+        }
+    }
+
+    if (current_code == 0x00){ //loop
+        Ion::Display::pushRect(KDRect(img_x, img_y, 32, 32), reinterpret_cast<const KDColor*>(save_buffer));
+        loadAnimation(buffer);
+    }
+}
+
+void Controller::applyScreenChanges(const uint8_t* byte_buffer){
+    bool need_redraw = !((img_x==old_x) && (img_y==old_y));
+
+    if (need_redraw){
+        Ion::Display::pushRect(KDRect(old_x, old_y, 32, 32), reinterpret_cast<const KDColor*>(save_buffer));
+        Ion::Display::pullRect(KDRect(img_x, img_y, 32, 32), reinterpret_cast<KDColor*>(save_buffer));
+
+        old_x = img_x;
+        old_y = img_y;
+
+        for (int i = 0; i < 1024; i++) {
+            if (transparent_mask[i]) {
+                img_buffer[i] = save_buffer[i];
+            }
+        }
+    }
+
+    //get number of changes
+    int n = *reinterpret_cast<const uint8_t*>(byte_buffer + offset);
+    offset += sizeof(uint8_t);
+
+    //apply changes
+    for (int i=0; i<n; i++){
+        //get pixels coordinate
+        uint8_t xy = *reinterpret_cast<const uint8_t*>(byte_buffer + offset);
+        offset += sizeof(uint8_t);
+
+        int x = xy >> 4;
+        int y = xy & 0x0F;
+
+        //get pixel color
+        uint16_t color_val = *reinterpret_cast<const uint16_t*>(byte_buffer + offset);
+        KDColor c = *reinterpret_cast<KDColor*>(&color_val);
+        offset += sizeof(uint16_t);
+
+        int target_x = x * 2;
+        int target_y = y * 2;
+
+        //apply changes
+        if (c == replacement_color){
+            uint16_t bg00 = save_buffer[(target_y * 32) + target_x];
+            uint16_t bg10 = save_buffer[(target_y * 32) + target_x + 1];
+            uint16_t bg01 = save_buffer[((target_y + 1) * 32) + target_x];
+            uint16_t bg11 = save_buffer[((target_y + 1) * 32) + target_x + 1];
+
+            img_buffer[(target_y * 32) + target_x] = bg00;
+            img_buffer[(target_y * 32) + target_x + 1] = bg10;
+            img_buffer[((target_y + 1) * 32) + target_x] = bg01;
+            img_buffer[((target_y + 1) * 32) + target_x + 1] = bg11;
+
+            if(!need_redraw){
+                Ion::Display::pushRectUniform(KDRect(img_x + target_x, img_y + target_y, 1, 1),
+                *reinterpret_cast<KDColor*>(&bg00));
+
+                Ion::Display::pushRectUniform(KDRect(img_x + target_x + 1, img_y + target_y, 1, 1),
+                *reinterpret_cast<KDColor*>(&bg10));
+
+                Ion::Display::pushRectUniform(KDRect(img_x + target_x, img_y + target_y + 1, 1, 1),
+                *reinterpret_cast<KDColor*>(&bg01));
+
+                Ion::Display::pushRectUniform(KDRect(img_x + target_x + 1, img_y + target_y + 1, 1, 1),
+                *reinterpret_cast<KDColor*>(&bg11));
+            }
+        }else{
+            uint16_t raw_c = *reinterpret_cast<uint16_t*>(&c);
+
+            img_buffer[(target_y * 32) + target_x] = raw_c;
+            img_buffer[(target_y * 32) + target_x + 1] = raw_c;
+            img_buffer[((target_y + 1) * 32) + target_x] = raw_c;
+            img_buffer[((target_y + 1) * 32) + target_x + 1] = raw_c;
+
+            if(!need_redraw){
+                Ion::Display::pushRectUniform(KDRect(img_x + target_x, img_y + target_y, 2, 2), c);
+            }
+        }
+    }
+
+    if(need_redraw){
+        Ion::Display::pushRect(KDRect(img_x, img_y, 32, 32), reinterpret_cast<const KDColor*>(img_buffer));
+    }
+}
+
+int Controller::getNumberOfArgsForCode(int code){
+    switch (code){
+        case 0x00: return 0; // loop
+        case 0x01: return 2; // move : x, y
+        case 0x02: return 0; // next
+        case 0x03: return 1; // jump : frame
+        case 0x04: return 1; // add_0 : value
+        case 0x05: return 1; // add_1 : value
+        case 0x06: return 1; // add_2 : value
+        case 0x07: return 1; // add_3 : value
+        case 0x08: return 3; // case : variable/ value, opperation, variable/ value
+        case 0x09: return 0; // lower
+        case 0x10: return 0; // higher
+        case 0x11: return 0; // equal
+        case 0x12: return 1; // set_0 : value
+        case 0x13: return 1; // set_1 : value
+        case 0x14: return 1; // set_2 : value
+        case 0x15: return 1; // set_3 : value
+        case 0x16: return 0; // var_0
+        case 0x17: return 0; // var_1
+        case 0x18: return 0; // var_2
+        case 0x19: return 0; // var_3
+        default: return 0;
+    }
+}
+
+void Controller::jump(const uint8_t* byte_buffer, uint8_t args[3]){
+    int n_frame = 0;
+    int tmp_offset = 520;
+
+    while (n_frame != args[0]){
+        uint8_t n_changes = *reinterpret_cast<const uint8_t*>(byte_buffer + tmp_offset);
+        tmp_offset += sizeof(uint8_t);
+        tmp_offset += n_changes * 3;
+
+        uint8_t tmp_current_code = 0xFF;
+        while (tmp_current_code != 0x00 && tmp_current_code != 0x02 && tmp_current_code != 0x03) {
+            tmp_current_code = *reinterpret_cast<const uint8_t*>(byte_buffer + tmp_offset);
+            tmp_offset += sizeof(uint8_t);
+
+            int tmp_n_args = getNumberOfArgsForCode(tmp_current_code);
+            tmp_offset += tmp_n_args;
+
+            if (tmp_current_code == 0x08){
+                for (int i = 0; i < 2; i++){
+                    tmp_current_code = *reinterpret_cast<const uint8_t*>(byte_buffer + tmp_offset);
+                    tmp_offset += sizeof(uint8_t);
+
+                    int tmp_n_args = getNumberOfArgsForCode(tmp_current_code);
+                    tmp_offset += tmp_n_args;
+                }
+            }
+        }
+
+        n_frame ++;
+    }
+
+    offset = tmp_offset;
+}
+
+void Controller::case_code(const uint8_t* byte_buffer, uint8_t args[3]){
+    int a;
+    switch (args[0]){
+        case 0x16: a = variables[0]; break;
+        case 0x17: a = variables[1]; break;
+        case 0x18: a = variables[2]; break;
+        case 0x19: a = variables[3]; break;
+        default: a = static_cast<int8_t>(args[0]);
+    }
+
+    int b;
+    switch (args[2]){
+        case 0x16: b = variables[0]; break;
+        case 0x17: b = variables[1]; break;
+        case 0x18: b = variables[2]; break;
+        case 0x19: b = variables[3]; break;
+        default: b = static_cast<int8_t>(args[2]);
+    }
+
+    if (!((args[1] == 0x09 && a < b) || (args[1] == 0x10 && a > b) || (args[1] == 0x11 && a == b))){
+        skip_next_instruction = true;
+    }
+}
+}
