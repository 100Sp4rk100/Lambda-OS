+#ifndef __LAMBDA_CLOCK_CONTROLLER_H__
+#define __LAMBDA_CLOCK_CONTROLLER_H__
+
+#include <escher/include/escher/selectable_list_view_controller.h>
+#include <escher/include/escher/list_view_data_source.h>
+#include <escher/include/escher/menu_cell.h>
+#include <escher/include/escher/menu_cell_with_editable_text.h>
+#include <escher/stack_view_controller.h>
+
+namespace LambdaApp {
+
+class ClockController : public Escher::ExplicitSelectableListViewController, Escher::TextFieldDelegate {
+    public:
+        ClockController(Escher::StackViewController* parentResponder);
+
+        int numberOfRows() const override { return 2; }
+        Escher::HighlightCell* cell(int row) override;
+
+        bool handleEvent(Ion::Events::Event e) override;
+
+        void didBecomeFirstResponder() override {
+            reloadStyle();
+            selectableListView()->reloadData();
+            m_cellSetClock.label()->setHighlighted(false);
+            m_cellSetClock.label()->setTextColor(Theme::ThemeGestion::getColor("KDColorBlack"));
+            selectRow(k_indexOfEnableClock);
+            Escher::App::app()->setFirstResponder(selectableListView());
+            Escher::SelectableListViewController<Escher::ExplicitListViewDataSource>::didBecomeFirstResponder();
+        }
+
+        bool textFieldDidFinishEditing(Escher::AbstractTextField* textField, Ion::Events::Event event) override;
+        void textFieldDidAbortEditing(Escher::AbstractTextField* textField) override;
+        bool textFieldDidReceiveEvent(Escher::AbstractTextField* textField, Ion::Events::Event event) override;
+        bool textFieldShouldFinishEditing(Escher::AbstractTextField* textField, Ion::Events::Event event) override;
+
+    private:
+        void reloadStyle();
+
+        constexpr static int k_indexOfEnableClock = 0;
+        constexpr static int k_indexOfSetTime = 1;
+
+        Escher::MenuCellWithEditableText<Escher::MessageTextView, Escher::MessageTextView> m_cellSetClock;
+        Escher::MenuCell<Escher::MessageTextView, Escher::MessageTextView, Escher::EmptyCellWidget> m_cellEnableClock;
+};
+
+}
+
+#endif
