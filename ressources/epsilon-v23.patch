+void ValuesController::didBecomeFirstResponder() {
+  EditableCellTableViewController::didBecomeFirstResponder();
+  if (selectedRow() == -1) {
+    selectableTableView()->deselectTable();
+    header()->setSelectedButton(0);
+  } else {
+    header()->setSelectedButton(-1);
+  }
+}
