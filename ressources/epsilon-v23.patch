@@ -0,0 +1,101 @@
+#include "clock_controller.h"
+#include <apps/i18n.h>
+#include <escher/include/escher/i18n.h>
+
+#include <apps/theme_gestion/themeGestion.h>
+#include <apps/clock_timer.h>
+
+namespace LambdaApp {
+
+ClockController::ClockController(Escher::StackViewController* parentResponder):
+    Escher::ExplicitSelectableListViewController(parentResponder)
+{
+    m_cellSetClock.label()->setMessage(I18n::Message::SubRow_Clock_1);
+    m_cellSetClock.textField()->setText(ClockTimer::ClockTimer::get());
+    m_cellEnableClock.label()->setMessage(I18n::Message::SubRow_Clock_2);
+    
+    selectRow(k_indexOfEnableClock);
+    centerTable(Escher::Metric::DisplayHeightWithoutTitleBar);
+
+    m_cellSetClock.textField()->setDelegate(this);
+}
+
+void ClockController::reloadStyle(){
+    m_cellEnableClock.label()->setTextColor(Theme::ThemeGestion::getColor("KDColorBlack"));
+    m_cellSetClock.label()->setTextColor(Theme::ThemeGestion::getColor("KDColorBlack"));
+    m_cellSetClock.textField()->setTextColor(Theme::ThemeGestion::getColor("KDColorBlack"));
+    m_cellSetClock.textField()->setText(ClockTimer::ClockTimer::get());
+    selectableListView()->setBackgroundColor(Theme::ThemeGestion::getColor("KDColorWhite"));
+}
+
+Escher::HighlightCell* ClockController::cell(int row) {
+    if (row == 1) return &m_cellSetClock;
+    return &m_cellEnableClock;
+}
+
+bool ClockController::handleEvent(Ion::Events::Event event) {
+  if (event == Ion::Events::OK || event == Ion::Events::Right || event == Ion::Events::EXE) {
+    if (selectedRow() == k_indexOfEnableClock){
+        
+        ClockTimer::ClockTimer::init();
+        if(ClockTimer::ClockTimer::isEnabled()){
+            ClockTimer::ClockTimer::desactivate();
+        }else{
+            ClockTimer::ClockTimer::activate();
+        }
+
+        static_cast<Escher::StackViewController*>(parentResponder())->pop();
+
+        return true;
+    }
+  }else if(event == Ion::Events::Left){
+    static_cast<Escher::StackViewController*>(parentResponder())->pop();
+    return true;
+  }
+  return false;
+}
+
+bool ClockController::textFieldDidFinishEditing(Escher::AbstractTextField* textField, Ion::Events::Event event) {
+    const char * time = textField->draftText();
+    
+    if (time && strlen(time) >= 5 && time[2] == ':') {
+        int h = (time[0] - '0') * 10 + (time[1] - '0');
+        int m = (time[3] - '0') * 10 + (time[4] - '0');
+        
+        ClockTimer::ClockTimer::set(h, m, 0);
+
+        m_cellSetClock.textField()->setText(ClockTimer::ClockTimer::get());
+
+        Escher::App::app()->setFirstResponder(selectableListView());
+        static_cast<Escher::StackViewController*>(parentResponder())->pop();
+        return true;
+    }
+    
+    Escher::App::app()->setFirstResponder(selectableListView());
+    return true;
+}
+
+void ClockController::textFieldDidAbortEditing(Escher::AbstractTextField* textField) {
+    textField->setText(ClockTimer::ClockTimer::get());
+    Escher::App::app()->setFirstResponder(selectableListView());
+}
+
+bool ClockController::textFieldDidReceiveEvent(Escher::AbstractTextField* textField, Ion::Events::Event event) {
+    if (event == Ion::Events::Up) {
+        Escher::App::app()->setFirstResponder(selectableListView());
+        selectRow(k_indexOfEnableClock);
+        return true;
+    }else if (event == Ion::Events::Left || event == Ion::Events::Back){
+        Escher::App::app()->setFirstResponder(selectableListView());
+        static_cast<Escher::StackViewController*>(parentResponder())->pop();
+        return true;
+    }
+
+    return false;
+}
+
+bool ClockController::textFieldShouldFinishEditing(Escher::AbstractTextField* textField, Ion::Events::Event event) {
+    return event == Ion::Events::OK || event == Ion::Events::EXE;
+}
+
+}
