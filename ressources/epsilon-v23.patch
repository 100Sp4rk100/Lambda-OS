-/* AbstractTextField */
-
-AbstractTextField::AbstractTextField(Responder *parentResponder,
-                                     View *contentView,
-                                     TextFieldDelegate *delegate)
-    : TextInput(parentResponder, contentView), m_delegate(delegate) {}
