+  KDCoordinate width = bounds().width();
+  KDCoordinate heightCenter = bounds().height() / 2;
+  KDCoordinate halfHeight = k_switchHeight / 2;
+  KDColor workingBuffer[k_switchWidth * k_switchHeight];
