+  Layout(const LayoutNode *node) : TreeHandle(node) {}
+  Layout clone() const;
+  LayoutNode *node() const {
+    assert(isUninitialized() ||
+           (TreeHandle::node() && !TreeHandle::node()->isGhost()));
+    return static_cast<LayoutNode *>(TreeHandle::node());
