-                   std::abs(v1) < Float<double>::EpsilonLax())
-                      ? 1.0
-                      : covariance(series, options) / std::sqrt(v0 * v1);
-  /* Due to errors, coefficient could slightly exceed 1.0. It needs to be
-   * fixed here to prevent r^2 from being bigger than 1. */
