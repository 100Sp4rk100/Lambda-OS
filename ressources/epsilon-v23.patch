-static SDL_bool AddDialogControl(WIN_DialogData *dialog, WORD type, DWORD style, DWORD exStyle, int x, int y, int w, int h, int id, const char *caption, WORD ordinal)
-{
-    DLGITEMTEMPLATEEX item;
-    WORD marker = 0xFFFF;
