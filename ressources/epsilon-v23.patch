+ThemeSelector::ThemeSelector(Escher::StackViewController* parentResponder):
+    Escher::ExplicitSelectableListViewController(parentResponder)
+    {
+        selectRow(Theme::ThemeGestion::getCurrent());
+
+        m_cells[0].label()->setMessage(I18n::Message::SubRow_Theme_1);
+        m_cells[1].label()->setMessage(I18n::Message::SubRow_Theme_2);
+        m_cells[2].label()->setMessage(I18n::Message::SubRow_Theme_3);
+        m_cells[3].label()->setMessage(I18n::Message::SubRow_Theme_4);
+        m_cells[4].label()->setMessage(I18n::Message::SubRow_Theme_5);
+
+        centerTable(Escher::Metric::DisplayHeightWithoutTitleBar);
+    }
+
+void ThemeSelector::reloadStyle(){
+    for (int i=0; i<5; i++){
+        m_cells[i].label()->setTextColor(Theme::ThemeGestion::getColor("KDColorBlack"));
+    }
+    selectableListView()->setBackgroundColor(Theme::ThemeGestion::getColor("KDColorWhite"));
+}
+
+Escher::HighlightCell* ThemeSelector::cell(int row) {
+    return &m_cells[row];
+}
+
+bool ThemeSelector::handleEvent(Ion::Events::Event event) {
+    if (event == Ion::Events::OK || event == Ion::Events::Right || event == Ion::Events::EXE) {
+        if (selectedRow()<4){
+            Theme::ThemeGestion::setCurrent(selectedRow());
+        }else{
+            if (Theme::DynamicColorProfilGestion::reload()){
+                Theme::ThemeGestion::setCurrent(4);
+            }else if(Theme::ThemeGestion::getCurrent() == 4){
+                Theme::ThemeGestion::setCurrent(0);
+            }
+        }
+
+        reloadStyle();
+        AppsContainer::sharedAppsContainer()->reloadTitleBarView();
+        selectableListView()->reloadData();
+        static_cast<Escher::StackViewController*>(parentResponder())->pop();
+        return true;
+
+    }else if(event == Ion::Events::Left){
+        static_cast<Escher::StackViewController*>(parentResponder())->pop();
+        return true;
+    }
+    return false;
+}
+
+}
