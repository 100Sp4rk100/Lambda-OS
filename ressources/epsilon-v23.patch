+    } else if (SDL_GL_GetCurrentContext() == NULL) {
+        return SDL_SetError("No OpenGL context has been made current");
+    } else if (_this->GL_SetSwapInterval) {
+        return _this->GL_SetSwapInterval(_this, interval);
+    } else {
