+ExternalSubController::ExternalSubController(Escher::StackViewController* parentResponder):
+    Escher::ExplicitSelectableListViewController(parentResponder)
+{
+    m_cellDelete.label()->setMessage(I18n::Message::DeleteFile);
+
+    m_cellMove.label()->setMessage(I18n::Message::MoveFile);
+    m_cellMove.subLabel()->setMessage(I18n::Message::MoveInternal);
+
+    m_cellCopie.label()->setMessage(I18n::Message::CopieFile);
+    m_cellCopie.subLabel()->setMessage(I18n::Message::CopieInternal);
+    
+    m_cellActivate.label()->setMessage(I18n::Message::Blank);
+
+    selectRow(k_indexOfName);
+    centerTable(Escher::Metric::DisplayHeightWithoutTitleBar);
+
+    m_cellName.textField()->setDelegate(this);
+}
+
+void ExternalSubController::setTree(InternalStorage::FileTree * tree){ 
+    m_tree = tree;
+    m_cellName.textField()->setText(m_tree->getCurrentName());
+
+    if (!(strcmp(m_tree->getCurrentExtension(), "theme") == 0 || strcmp(m_tree->getCurrentExtension(), "anim") == 0)){
+        m_cellActivate.label()->setMessage(I18n::Message::Unavailable);
+    }else{
+        m_cellActivate.label()->setMessage(I18n::Message::ActivateFile);
+    }
+};
