@@ -0,0 +1,29 @@
+#include "warning_external_controller.h"
+
+#include <ion/include/ion/storage/file_system.h>
+#include <apps/i18n.h>
+
+namespace Explorer {
+
+WarningExternalController::WarningExternalController()
+    : Shared::MessagePopUpController(
+            Escher::Invocation::Builder<WarningExternalController>(
+                [](WarningExternalController* controller, void* sender) {
+                return controller->handleButton();
+                },
+                this),
+            I18n::Message::DeleteSys) {}
+
+bool WarningExternalController::handleButton() const {
+    Ion::Storage::Record file_record = Ion::Storage::FileSystem::sharedFileSystem->recordNamed(record_name);
+            
+    if (file_record.isNull() || !Ion::Storage::FileSystem::sharedFileSystem->hasRecord(file_record)) {
+        return false;
+    }
+
+    file_record.tryToDestroy();
+    Ion::Storage::FileSystem::sharedFileSystem->notifyChangeToDelegate(file_record);
+    stack->pop();
+    return true;
+}
+}
