+            /* Get any leftovers */
+            switch (width & 3) {
+            case 3:
+                RGB888_RGB555(dst, src);
+                ++src;
+                ++dst;
+            case 2:
+                RGB888_RGB555_TWO(dst, src);
+                src += 2;
+                dst += 2;
+                break;
+            case 1:
+                RGB888_RGB555(dst, src);
+                ++src;
+                ++dst;
+                break;
+            }
+            src += srcskip;
+            dst += dstskip;
+        }
+    }
