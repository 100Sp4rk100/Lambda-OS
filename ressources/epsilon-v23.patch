+#include "theme_controller.h"
+#include <apps/i18n.h>
+
+#include <apps/theme_gestion/themeGestion.h>
+#include <apps/animation/animation.h>
+
+namespace LambdaApp {
+
+ThemeController::ThemeController(Escher::StackViewController* parentResponder, ThemeSelector * themeSelector):
+    Escher::ExplicitSelectableListViewController(parentResponder),
+    m_themeSelector(themeSelector)
+{
+    m_cellWithChevron.label()->setMessage(I18n::Message::SubRow_Theme_7);
+    m_cellWithoutChevron.label()->setMessage(I18n::Message::SubRow_Theme_6);
+    m_cellAnimation.label()->setMessage(I18n::Message::SubRow_Theme_8);
+    
+    selectRow(k_indexOfSelectTheme);
+    centerTable(Escher::Metric::DisplayHeightWithoutTitleBar);
+}
+
+void ThemeController::reloadStyle(){
+    m_cellWithChevron.label()->setTextColor(Theme::ThemeGestion::getColor("KDColorBlack"));
+    m_cellWithoutChevron.label()->setTextColor(Theme::ThemeGestion::getColor("KDColorBlack"));
+    m_cellAnimation.label()->setTextColor(Theme::ThemeGestion::getColor("KDColorBlack"));
+    selectableListView()->setBackgroundColor(Theme::ThemeGestion::getColor("KDColorWhite"));
+}
+
+Escher::HighlightCell* ThemeController::cell(int row) {
+    if (row == k_indexOfSelectTheme) return &m_cellWithChevron;
+    else if (row == k_indexOfAnimation) return &m_cellAnimation;
+    return &m_cellWithoutChevron;
+}
+
+bool ThemeController::handleEvent(Ion::Events::Event event) {
+  if (event == Ion::Events::OK || event == Ion::Events::Right || event == Ion::Events::EXE) {
+    if (selectedRow() == k_indexOfSelectTheme){
+        stackOpenPage(m_themeSelector);
+        return true;
+    }else if(selectedRow() == k_indexOfChangeIconTheme){
+        Theme::ThemeGestion::changeSquareIconState();
+        static_cast<Escher::StackViewController*>(parentResponder())->pop();
+        return true;
+    }else if(selectedRow() == k_indexOfAnimation){
+        if (AnimationGestion::Controller::is_running){
+            AnimationGestion::Controller::desactivate();
+        }else {
+            AnimationGestion::Controller::activate();
+        }
+        static_cast<Escher::StackViewController*>(parentResponder())->pop();
+        return true;
+    }
+  }else if(event == Ion::Events::Left){
+    static_cast<Escher::StackViewController*>(parentResponder())->pop();
+    return true;
+  }
+  return false;
+}
+
+}
