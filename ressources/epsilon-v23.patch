+int AbstractScrollableMultipleLayoutsView::ContentCell::numberOfSubviews()
+    const {
+  int nbOfSubviews = 1;
+  if (displayCenter()) {
+    nbOfSubviews += 2;
+  }
+  if (leftLayoutView()) {
+    nbOfSubviews += 1;
+  }
+  return nbOfSubviews;
+}
