+#ifndef USE_DUFFS_LOOP
+#define RGB888_RGB555_TWO(dst, src) { \
+    *(Uint32 *)(dst) = (((((src[HI])&0x00F80000)>>9)| \
+                         (((src[HI])&0x0000F800)>>6)| \
+                         (((src[HI])&0x000000F8)>>3))<<16)| \
+                         (((src[LO])&0x00F80000)>>9)| \
+                         (((src[LO])&0x0000F800)>>6)| \
