+    Escher::App(snapshot, &m_stackViewController),
+    m_themeSelector(&m_stackViewController),
+    m_themeController(&m_stackViewController, &m_themeSelector),
+    m_clockController(&m_stackViewController),
+    m_mainController(&m_stackViewController, &m_themeController, &m_clockController),
+    m_stackViewController(&m_modalViewController, &m_mainController,
+                            Escher::StackViewController::Style::GrayGradation)
+    {}
+
+}
