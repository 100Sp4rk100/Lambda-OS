+
+MainController::MainController(Escher::StackViewController* parentResponder, ExternalController* externalController, InternalController* internalController):
+    Escher::ExplicitSelectableListViewController(parentResponder),
+    m_externalController(externalController),
+    m_internalController(internalController)
