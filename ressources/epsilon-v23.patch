-int PythonVariableBoxController::numberOfRows() const {
-  int result = 0;
-  for (uint8_t origin = 0; origin < m_originsCount; ++origin) {
-    int nodeCount = nodesCountForOrigin(origin);
-    if (nodeCount > 0) {
-      result += nodeCount + (m_displaySubtitles ? 1 : 0);
