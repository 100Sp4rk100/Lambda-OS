+#include "internal_controller.h"
+
+#include <apps/internal_storage/manager.h>
+#include <poincare/print_int.h>
+
+namespace Explorer {
+    InternalController::InternalController(Escher::StackViewController* parentResponder, Escher::SelectableTableViewDataSource *selectionDataSource,
+    InternalSubController * subController):
+        ControllerTemplate(parentResponder, selectionDataSource, InternalStorage::InternalManager::fileTree),
+        m_subController(subController){
+            m_string_style.backgroundColor = Theme::ThemeGestion::getColor("KDColorWhite");
+            m_string_style.glyphColor = Theme::ThemeGestion::getColor("KDColorBlack");
+            m_string_style.font = KDFont::Size::Small;
+
+            m_dirty_style.backgroundColor = Theme::ThemeGestion::getColor("KDColorWhite");
+            m_dirty_style.glyphColor = Theme::ThemeGestion::getColor("KDColorRed");
+            m_dirty_style.font = KDFont::Size::Small;
+        }
+
+    void InternalController::selectCell(InternalStorage::FileTree * cell){
+        m_subController->setTree(cell);
+        stackOpenPage(m_subController);
+    }
+
+    void InternalController::reloadCells(){
+        m_string_style.backgroundColor = Theme::ThemeGestion::getColor("KDColorWhite");
+        m_string_style.glyphColor = Theme::ThemeGestion::getColor("KDColorBlack");
+        m_string_style.font = KDFont::Size::Small;
+
+        m_dirty_style.backgroundColor = Theme::ThemeGestion::getColor("KDColorWhite");
+        m_dirty_style.glyphColor = Theme::ThemeGestion::getColor("KDColorRed");
+        m_dirty_style.font = KDFont::Size::Small;
+
+        ControllerTemplate::reloadCells();
+    }
+
+    void InternalController::didBecomeFirstResponder(){
+        updateTree(InternalStorage::InternalManager::fileTree);
+    }
+
+    void InternalController::drawFileViewRect(KDContext* ctx, KDRect rect) const{
+        ControllerTemplate::drawFileViewRect(ctx, rect);
+
+        char used_space_buf[16];
+        char total_space_buf[16];
+
+        size_t total_size = InternalStorage::InternalManager::totalSize();
+        size_t used_size = InternalStorage::InternalManager::fileSpace;
+
+        formatSizeWithUnit(used_size, used_space_buf, sizeof(used_space_buf));
+        formatSizeWithUnit(total_size, total_space_buf, sizeof(total_space_buf));
+
+        char available_space_buffer[48];
+        int offset = 0;
+
+        size_t used_len = strlen(used_space_buf);
+        memcpy(available_space_buffer + offset, used_space_buf, used_len);
+        offset += used_len;
+
+        available_space_buffer[offset++] = ' ';
+        available_space_buffer[offset++] = '/';
+        available_space_buffer[offset++] = ' ';
+
+        size_t total_len = strlen(total_space_buf);
+        memcpy(available_space_buffer + offset, total_space_buf, total_len);
+        offset += total_len;
+        available_space_buffer[offset] = '\0';
+
+        ctx->drawString(available_space_buffer, KDPoint(10, 210), m_string_style);
+
+        char dirty_space_buffer[32];
+        size_t dirty_size = InternalStorage::InternalManager::dirtySpace;
+
+        formatSizeWithUnit(dirty_size, dirty_space_buffer, sizeof(dirty_space_buffer));
+
+        ctx->drawString(dirty_space_buffer, KDPoint(189, 210), m_dirty_style);
+    }
+
+    int InternalController::formatSizeWithUnit(size_t size_in_bytes, char* buffer, size_t buffer_size) {
+        const char* unit = "o";
+        size_t display_size = size_in_bytes;
+
+        if (size_in_bytes >= 1024) { // Ko
+            display_size = (size_in_bytes + 512) / 1024;
+            unit = "Ko";
+        }
+
+        int offset = Poincare::PrintInt::Left(display_size, buffer, buffer_size - 1);
+        
+        if (offset < static_cast<int>(buffer_size) - 4) {
+            buffer[offset++] = ' ';
+            size_t unit_len = strlen(unit);
+            for (size_t i = 0; i < unit_len; i++) {
+                buffer[offset++] = unit[i];
+            }
+            buffer[offset] = '\0';
+        }
+        return offset;
+    }
+}
