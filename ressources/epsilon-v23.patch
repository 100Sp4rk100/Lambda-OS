+#include "main_controller.h"
+#include <apps/i18n.h>
+
+namespace LambdaApp {
+
+MainController::MainController(Escher::StackViewController* parentResponder, 
+    ThemeController* themeController, ClockController* clockController):
+    Escher::UniformSelectableListController<
+          Escher::MenuCell<Escher::MessageTextView, Escher::MessageTextView,
+                           Escher::ChevronView>,
+          2>(parentResponder),
+    m_themeController(themeController),
+    m_clockController(clockController)
+    {
+        selectRow(k_indexOfTheme);
+        cell(k_indexOfTheme)
+            ->label()
+            ->setMessage(I18n::Message::MainRow_Theme);
+        cell(k_indexOfClock)
+            ->label()
+            ->setMessage(I18n::Message::MainRow_Clock);
+        centerTable(Escher::Metric::DisplayHeightWithoutTitleBar);
+    }
+
+void MainController::reloadStyle(){
+    for (int i=0; i<2; i++){
+        cell(i)->label()->setTextColor(Theme::ThemeGestion::getColor("KDColorBlack"));
+    }
+    selectableListView()->setBackgroundColor(Theme::ThemeGestion::getColor("KDColorWhite"));
+}
+
+bool MainController::handleEvent(Ion::Events::Event event) {
+  if (cell(selectedRow())->canBeActivatedByEvent(event)) {
+    if (selectedRow() == k_indexOfTheme){
+        stackOpenPage(m_themeController);
+        return true;
+    }else if (selectedRow() == k_indexOfClock){
+        stackOpenPage(m_clockController);
+        return true;
+    }
+  }
+  return false;
+}
+
+}
