@@ -0,0 +1,53 @@
+#include "animation_timer.h"
+
+#include "apps_container.h"
+#include <poincare/include/poincare/exam_mode.h>
+#include <poincare/include/poincare/preferences.h>
+
+#include "animation/animation.h"
+
+#include <ion.h>
+
+namespace AnimationTimer{
+
+int AnimationTimer::tick = 0;
+
+AnimationTimer& AnimationTimer::instance() {
+    static AnimationTimer inst;
+    return inst;
+}
+
+AnimationTimer::AnimationTimer()
+    : Timer(1) {}
+
+bool AnimationTimer::fire() {
+    AppsContainer *container = AppsContainer::sharedAppsContainer();
+    Escher::App::Snapshot *snapshot = container->activeApp()->snapshot();
+    
+    Poincare::Preferences* poincarePreferences = Poincare::Preferences::SharedPreferences();
+    Poincare::ExamMode examMode = poincarePreferences->examMode();
+
+    if (!(snapshot == container->homeAppSnapshot() && !examMode.isActive() && AnimationGestion::Controller::is_running)) {
+        return false;
+    }
+
+    if (AnimationGestion::Controller::tmp_b != nullptr) {
+        AnimationGestion::Controller::loadAnimation(AnimationGestion::Controller::tmp_b);
+    }
+
+    static uint32_t last_execution = 0;
+    uint32_t current_time = Ion::Timing::millis();
+
+    if (AnimationGestion::Controller::tick_ms > 0) {
+        if (current_time - last_execution < static_cast<uint32_t>(AnimationGestion::Controller::tick_ms)) {
+            return false;
+        }
+    }
+    
+    last_execution = current_time;
+    AnimationGestion::Controller::step();
+
+    return true;
+}
+
+}
