+#ifndef ANIMATION_H
+#define ANIMATION_H
+
+#include <stdint.h>
+#include <kandinsky/color.h>
+
+namespace AnimationGestion{
+
+    class Controller {
+    public:
+        static void loadAnimation(const void * b);
+        static void step();
+        static void activate(){ is_running = true; }
+        static void desactivate(){ is_running = false; }
+        static void waitToLoad(const void * b){ tmp_b = b; }
+
+        static bool is_running;
+        static int tick_ms;
+
+        static const void * tmp_b;
+
+    private:
+        static int getNumberOfArgsForCode(int code);
+        static void applyScreenChanges(const uint8_t* byte_buffer);
+        static void jump(const uint8_t* byte_buffer, uint8_t args[3]);
+        static void case_code(const uint8_t* byte_buffer, uint8_t args[3]);
+
+        static int offset;
+        static int img_x;
+        static int img_y;
+        static int old_x;
+        static int old_y;
+        static int variables[4];
+        static bool skip_next_instruction;
+
+        static const void* buffer;
+
+        static KDColor replacement_color;
+        static uint16_t img_buffer[1024];
+        static uint16_t save_buffer[1024];
+        static bool transparent_mask[1024];
+    };
+
+}
+
+#endif
