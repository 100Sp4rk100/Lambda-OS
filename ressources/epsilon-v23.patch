@@ -0,0 +1,80 @@
+#ifndef __INTERNAL_MANAGER_H__
+#define __INTERNAL_MANAGER_H__
+
+#include "record.h"
+#include "file.h"
+#include "file_tree.h"
+#include "adress_tree.h"
+
+#if PLATFORM_DEVICE
+extern "C" {
+  extern uint8_t _external_apps_flash_start;
+  extern uint8_t _external_apps_flash_end;
+}
+#endif
+
+namespace InternalStorage {
+
+enum Error {
+    Success = 0,
+    AdressTreeEmpty,
+    AdressError,
+    BadMagic,
+    SpaceError
+};
+
+class InternalManager {
+    public:
+        static uint8_t * managerStartAdress() {
+            #if PLATFORM_DEVICE
+                return &_external_apps_flash_start + 327680;
+            #else
+                return s_simulatorFlash;
+            #endif
+        }
+
+        static uint8_t * managerEndAdress() {
+            #if PLATFORM_DEVICE
+                return &_external_apps_flash_end;
+            #else
+                return s_simulatorFlash + k_simulatorFlashSize;
+            #endif
+        }
+
+        static size_t totalSize() {
+            #if PLATFORM_DEVICE
+                return managerEndAdress() - managerStartAdress();
+            #else
+                return k_simulatorFlashSize;
+            #endif
+        }
+
+        static Error notifyUpdate();
+        static Error fullErase();
+
+        static void initInternalStorage();
+
+        static Error saveFile(InternalFile file);
+        static Error eraseFile(InternalFile file);
+        static InternalFile getFile(const char * name);
+
+        static FileTree *fileTree;
+        static size_t fileSpace;
+        static size_t dirtySpace;
+
+    private:
+        static AdressTree *adressTree;
+        constexpr static uint32_t Magic = 0xEE0BDDBA;
+        constexpr  static size_t k_sectorSize = 64 * 1024;
+
+        #if !PLATFORM_DEVICE
+        constexpr static size_t k_simulatorFlashSize = 13 * k_sectorSize; 
+        static uint8_t s_simulatorFlash[k_simulatorFlashSize];
+        #endif
+
+        static uint32_t getPadingForBufferSize(uint32_t bufferSize);
+};
+
+}
+
+#endif
