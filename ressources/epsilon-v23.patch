+SDL_Window *
+SDL_GetFocusWindow(void)
+{
+    SDL_Window *window;
+
+    if (!_this) {
+        return NULL;
+    }
+    for (window = _this->windows; window; window = window->next) {
+        if (window->flags & SDL_WINDOW_INPUT_FOCUS) {
+            return window;
+        }
+    }
+    return NULL;
+}
