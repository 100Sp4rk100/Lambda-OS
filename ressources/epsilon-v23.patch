+void GraphController::setAbscissaInputAsFirstResponder() {
+  m_bannerView.abscissaValue()->setParentResponder(this);
+  m_bannerView.abscissaValue()->setDelegate(this);
+  App::app()->setFirstResponder(m_bannerView.abscissaValue());
+}
