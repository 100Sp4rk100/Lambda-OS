-    #elif __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
-      #define MP_ENDIANNESS_LITTLE (0)
-    #endif
-  #else
-    #include <endian.h>
-      #if defined(__BYTE_ORDER)
-        #if __BYTE_ORDER == __LITTLE_ENDIAN
