-float AbstractPlotView::pixelToFloat(Axis axis, KDCoordinate p) const {
-  return (axis == Axis::Horizontal) ? m_range->xMin() + p * pixelWidth()
-                                    : m_range->yMax() - p * pixelHeight();
-}
