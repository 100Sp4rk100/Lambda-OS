+            src += 2;
+        },
+        width);
+        /* *INDENT-ON* */
+        src += srcskip;
+        dst += dstskip;
+    }
+#else
+    while (height--) {
+        /* Copy in 4 pixel chunks */
+        for (c = width / 4; c; --c) {
+            *dst++ = RGB565_32(dst, src, map);
+            src += 2;
+            *dst++ = RGB565_32(dst, src, map);
+            src += 2;
+            *dst++ = RGB565_32(dst, src, map);
+            src += 2;
+            *dst++ = RGB565_32(dst, src, map);
+            src += 2;
+        }
+        /* Get any leftovers */
+        switch (width & 3) {
+        case 3:
+            *dst++ = RGB565_32(dst, src, map);
+            src += 2;
+        case 2:
+            *dst++ = RGB565_32(dst, src, map);
+            src += 2;
+        case 1:
+            *dst++ = RGB565_32(dst, src, map);
+            src += 2;
+            break;
+        }
+        src += srcskip;
+        dst += dstskip;
+    }
+#endif /* USE_DUFFS_LOOP */
