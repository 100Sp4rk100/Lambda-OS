+static int
+get_driindex(void)
+{
+    const unsigned int devcount = get_dricount();
+    unsigned int i;
+
+    for (i = 0; i < devcount; i++) {
+        if (check_modesetting(i)) {
+            return i;
+        }
+    }
+
+    return -ENOENT;
+}
