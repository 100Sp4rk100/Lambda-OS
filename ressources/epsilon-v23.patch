+#include "controller_template.h"
+
+#include <apps/theme_gestion/themeGestion.h>
+
+namespace Explorer {
+
+ControllerTemplate::FileView::FileView(ControllerTemplate* controller, Escher::SelectableTableViewDataSource* selectionDataSource)
+    : m_selectableTableView(controller, controller, selectionDataSource, controller),
+    m_controller(controller) {
+
+    m_selectableTableView.setBackgroundColor(Theme::ThemeGestion::getColor("KDColorWhite"));
+    m_selectableTableView.setMargins({WidthMargin, 0, WidthMargin, 0});
+}
+
+void ControllerTemplate::FileView::layoutSubviews(bool force) {
+  KDRect frame = KDRect(KDPointZero, bounds().width(), bounds().height()-20);
+  setChildFrame(&m_selectableTableView, frame, force);
+}
+
+ControllerTemplate::ControllerTemplate(Escher::StackViewController* parentResponder, Escher::SelectableTableViewDataSource *selectionDataSource, InternalStorage::FileTree * tree) :
+    Escher::ViewController(parentResponder),
+    m_view(this, selectionDataSource),
+    m_selectionDataSource(selectionDataSource){
+        file_tree = tree;
+        refreshCellsData();
+        reloadCells();
+}
+
+void ControllerTemplate::updateTree(InternalStorage::FileTree * tree){
+    file_tree = tree;
+    refreshCellsData();
+    reloadCells();
+}
+
+const Escher::Image * ControllerTemplate::getImage(const char * extension){
+    if (strcmp(extension, "eq") == 0 || strcmp(extension, "exp") == 0 || 
+        strcmp(extension, "func") == 0 || strcmp(extension, "lis") == 0 || 
+        strcmp(extension, "seq") == 0 || strcmp(extension, "mat") == 0 || 
+        strcmp(extension, "reg") == 0 || strcmp(extension, "pc") == 0) {
+        return Theme::ThemeGestion::getIconImage("CalculationData");
+    }else if (strcmp(extension, "sys") == 0 ){
+        return Theme::ThemeGestion::getIconImage("Sys");
+    }else if (strcmp(extension, "py") == 0 ){
+        return Theme::ThemeGestion::getIconImage("Py");
+    }else if (strcmp(extension, "theme") == 0 ){
+        return Theme::ThemeGestion::getIconImage("Theme");
+    }else if (strcmp(extension, "anim") == 0 ){
+        return Theme::ThemeGestion::getIconImage("Animation");
+    }else{
+        return Theme::ThemeGestion::getIconImage("File");
+    }
+
+    return nullptr;
+}
+
+void ControllerTemplate::refreshCellsData(){
+    InternalStorage::FileTree *p_tree = file_tree;
+
+    for (int i=0; i<level*numberCellsForRows; i++){
+        if (p_tree != nullptr) {
+            p_tree = p_tree->getNextTree();
+        }
+    }
+
+    for (int i=0; i<numberCells; i++){
+        if (p_tree != nullptr){
+            const char * name = p_tree->getCurrentName();
+            const char * extension = p_tree->getCurrentExtension();
+
+            const Escher::Image * image = getImage(extension);
+
+            fileCells[i].updateData(name, image);
+            int position = level * numberCellsForRows + i;
+            fileCells[i].setHillight(position == selected);
+
+            p_tree = p_tree->getNextTree();
+        }else{
+            fileCells[i].updateData();
+            fileCells[i].setHillight(false);
+        }
+    }
+}
+
+void ControllerTemplate::reloadCells(){
+    InternalStorage::FileTree *p_tree = file_tree;
+
+    for (int i=0; i<numberCells; i++){
+        if (p_tree != nullptr){
+            fileCells[i].reload(getImage(p_tree->getCurrentExtension()));
+            p_tree = p_tree->getNextTree();
+        }
+    }
+}
+
+bool ControllerTemplate::handleEvent(Ion::Events::Event event){
+    int files_count = totalFilesCount();
+    if (files_count == 0){
+        return false;
+    }
+
+    int oldSelected = selected;
+    if (event == Ion::Events::Down) {
+        if (selected + numberCellsForRows < files_count) {
+            selected += numberCellsForRows;
+        }
+    } 
+    else if (event == Ion::Events::Up) {
+        if (selected - numberCellsForRows >= 0) {
+            selected -= numberCellsForRows;
+        }
+    } 
+    else if (event == Ion::Events::Right) {
+        if (selected + 1 < files_count) {
+            selected++;
+        }
+    } 
+    else if (event == Ion::Events::Left) {
+        if (selected - 1 >= 0) {
+            selected--;
+        }
+    } 
+    else if (event == Ion::Events::OK || event == Ion::Events::EXE) {
+        InternalStorage::FileTree *p_tree = file_tree;
+        for (int i = 0; i < selected && p_tree != nullptr; i++) {
+            p_tree = p_tree->getNextTree();
+        }
+        if (p_tree != nullptr) {
+            selectCell(p_tree);
+        }
+        return true;
+    }
+
+    if (selected != oldSelected) {
+        int selectedRow = selected / numberCellsForRows;
+
+        if (selectedRow < level) {
+            level = selectedRow;
+        } 
+        else if (selectedRow >= level + numberRows) {
+            level = selectedRow - numberRows + 1;
+        }
+
+        refreshCellsData();
+        reloadCells();
+        return true;
+    }
+
+    return false;
+}
+
+int ControllerTemplate::totalFilesCount() const {
+    int count = 0;
+    InternalStorage::FileTree *p_tree = file_tree;
+    while (p_tree != nullptr) {
+        count++;
+        p_tree = p_tree->getNextTree();
+    }
+    return count;
+}
+
+}
