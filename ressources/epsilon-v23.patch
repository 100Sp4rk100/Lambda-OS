+  if ((tokenKind >= MP_TOKEN_OP_TILDE &&
+       tokenKind <= MP_TOKEN_DEL_DBL_STAR_EQUAL) ||
+      tokenKind == MP_TOKEN_DEL_EQUAL || tokenKind == MP_TOKEN_DEL_MINUS_MORE) {
+    return OperatorColor;
+  }
