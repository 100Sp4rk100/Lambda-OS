+    void setShowEqualSignAfterFormula(bool showEqual) {
+      m_leftLayoutView.setShowEqual(showEqual);
+    }
+    void setHighlightWholeCell(bool highlightWholeCell) {
+      m_highlightWholeCell = highlightWholeCell;
+    };
