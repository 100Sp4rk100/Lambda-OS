-//---------------------------------------------------------------------------
-// Scale and clamp values to a range
-//---------------------------------------------------------------------------
-static float RemapValClamped( float val, float A, float B, float C, float D)
-{
-    if ( A == B )
-    {
-        return ( val - B ) >= 0.0f ? D : C;
-    }
-    else
-    {
-        float cVal = (val - A) / (B - A);
-        cVal = clamp( cVal, 0.0f, 1.0f );
-
-        return C + (D - C) * cVal;
-    }
-}
