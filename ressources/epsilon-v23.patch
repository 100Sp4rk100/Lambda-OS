-SDL_GetScancodeName(SDL_Scancode scancode)
-{
-    const char *name;
-    if (((int)scancode) < SDL_SCANCODE_UNKNOWN || scancode >= SDL_NUM_SCANCODES) {
-          SDL_InvalidParamError("scancode");
-          return "";
-    }
-
-    name = SDL_scancode_names[scancode];
-    if (name)
-        return name;
-    else
-        return "";
