+
+MessagePopUpController::MessagePopUpController(Invocation OkInvocation,
+                                               I18n::Message warningMessage,
+                                               I18n::Message okMessage,
+                                               I18n::Message cancelMessage)
+    : PopUpController(OkInvocation,
+                      Invocation(
