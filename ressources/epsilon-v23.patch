-        self._serial_number, self._product, self._manufacturer = None, None, None
-        self._langids = None
-
-        desc = backend.get_device_descriptor(dev)
-
-        _set_attr(
-            desc,
-            self,
-            (
-                "bLength",
-                "bDescriptorType",
-                "bcdUSB",
-                "bDeviceClass",
-                "bDeviceSubClass",
-                "bDeviceProtocol",
-                "bMaxPacketSize0",
-                "idVendor",
-                "idProduct",
-                "bcdDevice",
-                "iManufacturer",
-                "iProduct",
-                "iSerialNumber",
-                "bNumConfigurations",
-                "address",
-                "bus",
-                "port_number",
-                "port_numbers",
-                "speed",
-            ),
-        )
-
-        if desc.bus is not None:
