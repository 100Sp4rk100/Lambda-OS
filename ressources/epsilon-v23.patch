-void LayoutCursor::setLayout(Layout l, OMG::HorizontalDirection sideOfLayout) {
-  if (!l.isHorizontal() && !l.parent().isUninitialized() &&
-      l.parent().isHorizontal()) {
-    m_layout = l.parent();
-    m_position = m_layout.indexOfChild(l) + (sideOfLayout.isRight());
