+#ifndef __INTERNAL_FILE_H__
+#define __INTERNAL_FILE_H__
+
+#include <string.h>
+#include "record.h"
+#include "common.h"
+
+namespace InternalStorage {
+
+class InternalFile {
+    public:
+        InternalFile(const char * name = nullptr, const char * extension = nullptr) {
+            memset(m_full_name, 0, maxNameLength);
+            if (name == nullptr) {
+                return;
+            }
+
+            if (extension == nullptr) {
+                size_t i = 0;
+                while (i < maxNameLength - 1 && name[i] != '\0') {
+                    m_full_name[i] = name[i];
+                    i++;
+                }
+                m_full_name[i] = '\0';
+            } else {
+                size_t nameLen = strlen(name);
+                size_t extLen = strlen(extension);
+
+                if (nameLen + 1 + extLen >= maxNameLength) {
+                    if (extLen < maxNameLength - 2) {
+                        nameLen = maxNameLength - 2 - extLen;
+                    } else {
+                        nameLen = 0;
+                    }
+                }
+
+                memcpy(m_full_name, name, nameLen);
+                
+                m_full_name[nameLen] = '.';
+
+                size_t destIndex = nameLen + 1;
+                size_t srcIndex = 0;
+                while (destIndex < maxNameLength - 1 && extension[srcIndex] != '\0') {
+                    m_full_name[destIndex] = extension[srcIndex];
+                    destIndex++;
+                    srcIndex++;
+                }
+                m_full_name[destIndex] = '\0';
+            }
+        }
+
+        bool isValable() { 
+            return m_full_name[0] != '\0'; 
+        }
+
+        const char* getName() {
+            return m_full_name;
+        }
+
+        const char* getExtension() { 
+            const char * dotPointer = strchr(m_full_name, '.');
+            if (dotPointer != nullptr) {
+                return dotPointer + 1;
+            }
+            return "";
+        }
+
+        InternalRecord record;
+
+    private:
+        char m_full_name[maxNameLength]; 
+};
+
+}
+
+#endif
