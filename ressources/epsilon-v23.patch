-/* toggle d'n'd for all existing windows. */
-void
-SDL_ToggleDragAndDropSupport(void)
-{
-    if (_this && _this->AcceptDragAndDrop) {
-        const SDL_bool enable = IsAcceptingDragAndDrop();
-        SDL_Window *window;
-        for (window = _this->windows; window; window = window->next) {
