+bool ExternalSubController::textFieldDidReceiveEvent(Escher::AbstractTextField* textField, Ion::Events::Event event) {
+    if (event == Ion::Events::Down) {
+        Escher::App::app()->setFirstResponder(selectableListView());
+        selectRow(k_indexOfDelete);
+        return true;
+    }else if (event == Ion::Events::Back){
+        Escher::App::app()->setFirstResponder(selectableListView());
+        static_cast<Escher::StackViewController*>(parentResponder())->pop();
+        return true;
+    }
+
+    return false;
+}
